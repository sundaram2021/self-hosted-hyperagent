# --- Database (docker-compose provides this Postgres instance) ---
DATABASE_URL=postgres://hyperagent:hyperagent@localhost:5432/hyperagent

# --- Agent server (apps/server) ---
SERVER_PORT=8787
SERVER_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# --- Sandbox service (apps/sandbox) ---
SANDBOX_PORT=8788
# Where the agent server reaches the sandbox for execute_code
SANDBOX_URL=http://localhost:8788
# Per-execution wall-clock limit (ms)
SANDBOX_EXECUTE_TIMEOUT_MS=30000

# --- Integrations ---
# Exa web search (https://dashboard.exa.ai/api-keys) — or save it in Settings
# EXA_API_KEY=
# Optional: raises GitHub rate limits for skill installs
# GITHUB_TOKEN=

# --- Memory (Phase 8) ---
# Long-term memory with hybrid recall (needs OpenAI or Google key for embeddings)
MEMORY_ENABLED=true
# Post-turn LLM memory extraction — spends tokens, opt-in
MEMORY_AUTO_EXTRACT=false
# Memories injected into context per turn
MEMORY_RECALL_K=5

# --- Agent loop ---
# Max model steps (tool-call rounds) per turn
AGENT_MAX_STEPS=8

# --- Web app (apps/web) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_SANDBOX_URL=http://localhost:8788

# --- Secrets ---
# Encrypts provider API keys stored via the Settings UI (AES-256-GCM).
# Generate one with: openssl rand -hex 32
APP_SECRET=

# Apply pending DB migrations when the server boots (recommended)
MIGRATE_ON_START=true

# --- Provider API keys (all optional — set the ones you use) ---
# Environment variables always take precedence over keys saved in the UI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# DASHSCOPE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- API rate limit (requests/minute) ---
RATE_LIMIT_MAX=600
