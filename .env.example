# --- Database (docker-compose provides this Postgres instance) ---
DATABASE_URL=postgres://hyperagent:hyperagent@localhost:5432/hyperagent

# --- Agent server (apps/server) ---
SERVER_PORT=8787
SERVER_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000

# --- Sandbox service (apps/sandbox) ---
SANDBOX_PORT=8788

# --- Web app (apps/web) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_SANDBOX_URL=http://localhost:8788

# --- Secrets (used from Phase 2 for encrypting provider keys at rest) ---
# Generate one with: openssl rand -hex 32
APP_SECRET=
